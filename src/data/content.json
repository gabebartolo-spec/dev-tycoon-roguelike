  "studios": [
    { "id": "garage", "name": "Garage Studio", "text": "Where everyone starts. No perks, no catches.", "mods": [] },
    { "id": "open_source", "name": "Open-Source Engine", "text": "No licence fee (rent -$200/wk), but code counts 10% less and Prototype takes a week longer.", "mods": [ { "kind": "rent", "add": -200 }, { "kind": "deptWeight", "dept": "code", "mul": 0.9 }, { "kind": "phaseWeeks", "phase": "prototype", "add": 1 } ] },
    { "id": "publisher_deal", "name": "Publisher Deal", "text": "+$30k up front, but the publisher takes 15% of every sale.", "mods": [ { "kind": "cash", "add": 30000 }, { "kind": "sales", "mul": 0.85 } ] },
    { "id": "co_op", "name": "Worker Co-op", "text": "Salaries 10% lower, but the team burns out twice as fast and you start one worker short.", "mods": [ { "kind": "salary", "mul": 0.9 }, { "kind": "burnout", "mul": 2 }, { "kind": "rosterSize", "add": -1 } ] },
    { "id": "weekend_project", "name": "Weekend Project", "text": "You start with a Coding Agent on the team; Prototype takes a week less.", "mods": [ { "kind": "startWorker", "id": "coding_agent" }, { "kind": "phaseWeeks", "phase": "prototype", "add": -1 } ] },
    { "id": "bedroom", "name": "Bedroom", "text": "You start alone, with The Auteur and $20k less cash. No rent while you work alone; hire anyone and you pay full rent.", "mods": [ { "kind": "startWorker", "id": "auteur" }, { "kind": "rentFreeUpTo", "value": 1 }, { "kind": "cash", "add": -20000 }, { "kind": "rosterSize", "add": -5 } ] },
    { "id": "asset_flip_farm", "name": "Asset Flip Farm", "text": "You start with a Code Pack, an Art Pack, an Audio Pack and The Flipper.", "mods": [ { "kind": "startWorker", "id": "code_pack" }, { "kind": "startWorker", "id": "art_pack" }, { "kind": "startWorker", "id": "audio_pack" }, { "kind": "startWorker", "id": "flipper" } ] },
    { "id": "hype_machine", "name": "Hype Machine", "text": "You start with the Visionary CEO. Every game must carry at least one promise.", "mods": [ { "kind": "startWorker", "id": "visionary_ceo" }, { "kind": "minPromises", "value": 1 } ] },
    { "id": "tech_demo_lab", "name": "Tech Demo Lab", "text": "You start with the Graphics Programmer. Production takes a week longer.", "mods": [ { "kind": "startWorker", "id": "graphics_programmer" }, { "kind": "phaseWeeks", "phase": "production", "add": 1 } ] }
  ],
  "unlocks": [
    { "id": "studio_open_source", "name": "Open-Source Engine", "text": "Starting studio: cheaper rent, weaker code, slower Prototype.", "cost": 10, "studio": "open_source" },
    { "id": "studio_publisher", "name": "Publisher Deal", "text": "Starting studio: cash now, smaller sales forever.", "cost": 15, "studio": "publisher_deal" },
    { "id": "studio_coop", "name": "Worker Co-op", "text": "Starting studio: cheap team that burns out fast.", "cost": 20, "studio": "co_op" },
    { "id": "veterans", "name": "Industry veterans", "text": "Adds Gus (QA veteran) and Ivy (streamer) to the draft pool. They are pricey and crowd out cheaper hires.", "cost": 12, "workers": ["gus", "ivy"] },
    { "id": "genre_strategy", "name": "Strategy genre", "text": "Adds Strategy to pitches and the market. A design-heavy genre; more genres also spread your pitches thinner.", "cost": 18, "genres": ["strategy"] },
    { "id": "dept_qa", "name": "QA department", "text": "Adds a QA slot: the worker there fixes 0.5 bugs per Code point instead of adding quality. Upkeep +$150/wk.", "cost": 15, "departments": ["qa"], "mods": [ { "kind": "rent", "add": 150 } ] },
    { "id": "dept_marketing", "name": "Marketing department", "text": "Adds a Marketing slot: the worker there adds 0.4 hype per Design point instead of quality. Upkeep +$250/wk.", "cost": 15, "departments": ["marketing"], "mods": [ { "kind": "rent", "add": 250 } ] },
    { "id": "vibecoding", "name": "Vibecoding", "text": "Starting studio Weekend Project, AI cards and vibecoding events. AI cards are cheap and never burn out, but a game they work on hands 15% of its bugs to the next one; each Era a new model makes them better and pricier.", "cost": 12, "studio": "weekend_project", "workers": ["autocomplete", "coding_agent", "image_model", "grumpy_senior", "indie_hacker", "prompt_engineer"], "events": ["agent_deleted_prod", "price_hike", "vibe_jam", "disclosure_backlash"] },
    { "id": "solo_dev", "name": "Solo Dev", "text": "Starting studio Bedroom, solo cards and solo events. A solo card can work several desks at once, but each extra desk adds a week to the phase; a game made only by solo cards keeps selling longer.", "cost": 12, "studio": "bedroom", "workers": ["auteur", "pixel_hermit", "hobbyist", "composer_coder", "contract_artist", "community_manager"], "events": ["seventy_hour_weeks", "ten_copies", "publisher_calls", "asset_pack_sale"] },
    { "id": "shovelware", "name": "Shovelware", "text": "Starting studio Asset Flip Farm, asset packs, flipper cards and shovelware events. Reskin your last game (same genre, new topic, no Prototype): it sells as if it reviewed at least 5, but floods its genre (-10% demand this Quarter) and, under review 7, costs 5% of all sales (down to half) until a game reviews 7 or more.", "cost": 12, "studio": "asset_flip_farm", "workers": ["code_pack", "art_pack", "audio_pack", "flipper", "trailer_editor", "tutorial_youtuber", "bundle_broker"], "events": ["bundle_deal", "viral_clone", "chart_change"], "mods": [ { "kind": "reskin" } ] },
    { "id": "overpromiser", "name": "Overpromiser", "text": "Starting studio Hype Machine, promise cards and press events. Each pitch offers 3 promises; take up to 3 for +12 hype each. A game reviewing under a promise's bar breaks it: 20% of its sales are refunded and later games review 1 lower. Each game you ship clears 1 point; a game reviewing 8 or more clears it all.", "cost": 12, "studio": "hype_machine", "workers": ["visionary_ceo", "pr_manager", "apology_writer"], "events": ["trailer_drop", "demo_request", "fan_wiki"], "mods": [ { "kind": "promises" } ] },
    { "id": "tech", "name": "Tech", "text": "Starting studio Tech Demo Lab, Tech cards and hardware events. Four Tech platforms launch at random Quarters; their audience rises from 10% to 40% and falls back over 7 Quarters, then they die. A game may target a live one: +$10,000 from the platform partner and +10 hype, but Production takes a week longer (not with a Dev Kit card) and it sells only to that platform's audience at release. A game reviewing 8 or more breaks out and sells to everyone.", "cost": 12, "studio": "tech_demo_lab", "workers": ["graphics_programmer", "hardware_hacker", "motion_designer"], "events": ["showcase_invite", "hardware_price_cut", "platform_layoffs"], "mods": [ { "kind": "tech" } ] }
  ],
